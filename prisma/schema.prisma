generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  DEVELOPER
  EMPLOYER
  OWNER
}

enum UserStatus {
  ACTIVE
  MUTED
  BANNED
}

enum JobStatus {
  PENDING
  APPROVED
  REJECTED
  DISABLED
}

enum LocationType {
  ONSITE
  HYBRID
  REMOTE
}

enum SalaryType {
  HOURLY
  MONTHLY
  YEARLY
}

enum ApplicationStatus {
  PENDING
  REVIEWING
  SHORTLISTED
  REJECTED
  ACCEPTED
}

// ─── Core User ──────────────────────────────────────────────────────────────

model User {
  id        String     @id @default(uuid())
  email     String     @unique
  password  String?
  role      Role
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  developer    Developer?
  employer     Employer?
  otpCodes     OtpCode[]
  favoriteJobs FavoriteJob[]

  @@map("users")
}

// ─── Developer ──────────────────────────────────────────────────────────────

model Developer {
  id       String @id @default(uuid())
  userId   String @unique
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Step 2
  fullName       String?
  title          String?
  phone          String?
  location       String?
  country        String?
  gender         String?
  birthYear      Int?
  linkedin       String?
  github         String?
  summary        String?
  skills         String[]
  workExperience Json?
  education      Json?
  languages      Json      @default("[]")

  // Step 3
  photoUrl       String?
  introVideoUrl  String?
  introVideoType String?

  // Step 4
  idCardUrl String?

  profileStep Int     @default(1)
  isVerified  Boolean @default(false)
  verifiedAt  DateTime?
  isBot       Boolean @default(false)

  applications        Application[]
  messages            Message[]
  directConversations Conversation[] @relation("DirectConvos")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("developers")
}

// ─── Employer ───────────────────────────────────────────────────────────────

model Employer {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Step 2
  companyName      String?
  companyWebsite   String?
  companySummary   String?
  companySize      String?
  companyLocation  String?
  country          String?
  companyLinkedin  String?
  contactName      String?
  contactRole      String?
  contactInfo      String?

  // Step 3
  companyLogoUrl  String?
  companyBrandUrl String?
  companyAdImages String[]
  contactPhotoUrl String?
  introVideoUrl   String?
  introVideoType  String?

  // Step 4
  idCardUrl String?

  profileStep Int     @default(1)
  isVerified  Boolean @default(false)
  verifiedAt  DateTime?
  isBot       Boolean @default(false)

  jobs          Job[]
  conversations Conversation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("employers")
}

// ─── OTP Codes ──────────────────────────────────────────────────────────────

model OtpCode {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String
  type      String   // signup | email_change
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("otp_codes")
}

// ─── Jobs ───────────────────────────────────────────────────────────────────

model Job {
  id         String   @id @default(uuid())
  employerId String
  employer   Employer @relation(fields: [employerId], references: [id], onDelete: Cascade)

  title           String
  logoUrl         String?
  companyLocation String?
  locationType    LocationType

  salaryMin  Float?
  salaryMax  Float?
  salaryType SalaryType?
  currency   String?

  requiredSkills   String[]
  niceToHaveSkills String[]
  languages        String[]
  industry         String?
  description      String?

  status    JobStatus @default(PENDING)
  isPinned  Boolean   @default(false)
  isEnabled Boolean   @default(true)

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  applications Application[]
  favorites    FavoriteJob[]

  @@map("jobs")
}

// ─── Applications ───────────────────────────────────────────────────────────

model Application {
  id          String @id @default(uuid())
  jobId       String
  job         Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  developerId String
  developer   Developer @relation(fields: [developerId], references: [id], onDelete: Cascade)

  coverLetter String?
  appliedData Json

  status ApplicationStatus @default(PENDING)

  conversation Conversation?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([jobId, developerId])
  @@map("applications")
}

// ─── Conversations & Messages ────────────────────────────────────────────────

model Conversation {
  id            String       @id @default(uuid())
  applicationId String?      @unique
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  // Direct DM participants (populated when applicationId is null)
  developerId     String?
  developer       Developer? @relation("DirectConvos", fields: [developerId], references: [id])
  employerId      String?
  employer        Employer?  @relation(fields: [employerId], references: [id])
  initiatorUserId String?    // userId of OWNER when OWNER initiates the DM

  isBlocked Boolean @default(false)

  messages Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  senderRole     Role

  content     String
  attachments String[]

  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  // Developer sender link (optional — senderRole determines which)
  developer   Developer? @relation(fields: [senderId], references: [id])

  @@map("messages")
}

// ─── Favorites ───────────────────────────────────────────────────────────────

model FavoriteJob {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, jobId])
  @@map("favorite_jobs")
}

// ─── Job Board (felovy-search scraped jobs) ─────────────────────────────────

model BoardJob {
  id String @id @default(uuid())

  ats           String
  boardToken    String @map("board_token")
  externalJobId String @map("external_job_id")

  title          String?
  companyName    String?   @map("company_name")
  locationName   String?   @map("location_name")
  absoluteUrl    String?   @map("absolute_url")
  firstPublished DateTime? @map("first_published")
  sourceUpdatedAt DateTime? @map("source_updated_at")
  contentHtml    String?   @map("content_html") @db.Text
  contentText    String?   @map("content_text") @db.Text
  departmentsJson String?  @map("departments_json")
  officesJson    String?   @map("offices_json")
  metadataJson   String?   @map("metadata_json")
  remoteStatus   String?   @map("remote_status")
  language       String?
  employmentType String?   @map("employment_type")
  countryCode    String?   @map("country_code")
  region         String?

  logoUrl            String?  @map("logo_url")
  scrapedAt          DateTime @default(now()) @map("scraped_at")
  seenInLastScrape   Boolean  @default(true) @map("seen_in_last_scrape")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([ats, boardToken, externalJobId])
  @@index([firstPublished])
  @@index([sourceUpdatedAt])
  @@index([ats])
  @@index([remoteStatus])
  @@index([region])
  @@index([scrapedAt])
  @@map("board_jobs")
}

// ─── Job Board Search (felovy-search platforms & tokens) ────────────────────

model BoardPlatform {
  slug                String  @id
  label               String
  domain              String?
  integration         String?
  listUrlTemplate     String? @map("list_url_template")
  headersJson         String  @default("{\"User-Agent\":\"Felovy/1.0\"}") @map("headers_json")
  paginationJson      String? @map("pagination_json")
  jobsPath            String? @map("jobs_path")
  responseFormat      String? @map("response_format")
  descriptionFromList Boolean @default(false) @map("description_from_list")
  scrapeable          Boolean @default(false)
  concurrency         Int     @default(10)
  agentEnabled        Boolean @default(false) @map("agent_enabled")
  sortOrder           Int     @default(0) @map("sort_order")
  catalogJson         String? @map("catalog_json") @db.Text

  tokens BoardToken[]

  @@map("board_platforms")
}

model BoardToken {
  ats           String
  boardToken    String        @map("board_token")
  platform      BoardPlatform @relation(fields: [ats], references: [slug], onDelete: Cascade)
  enabled       Boolean       @default(true)
  lastScrapedAt DateTime?     @map("last_scraped_at")
  lastStatus    String?       @map("last_status")
  lastError     String?       @map("last_error") @db.Text
  lastJobCount  Int?          @map("last_job_count")
  logoUrl       String?       @map("logo_url")
  logoFetchedAt DateTime?     @map("logo_fetched_at")
  openedCount   Int           @default(0) @map("opened_count")

  @@id([ats, boardToken])
  @@index([ats])
  @@index([boardToken])
  @@map("board_tokens")
}

model AppMeta {
  key   String @id
  value String @db.Text

  @@map("app_meta")
}
